#!/bin/sh
#
# Usage: get-unleash-password <namespace> [context]
#
# Prints the Unleash admin password for a feature-branch environment on the
# branch cluster (context defaults to AKS-BRANCH1).
#
#   get-unleash-password tr-active-pieces-strangler

set -eu

if [ $# -lt 1 ]; then
  echo "usage: get-unleash-password <namespace> [context]" >&2
  exit 1
fi

namespace="$1"
context="${2:-AKS-BRANCH1}"

kubectl --context "$context" -n "$namespace" get secret unleash-admin \
  -o jsonpath='{.data.password}' | base64 -d
echo
