# Uncomment the following (and `zrpof` line at the end of the file) to debug
# performance issues
#
# zmodload zsh/zprof

# shortcut to this dotfiles path is $ZSH
export ZSH=${ZSH:-$HOME/.dotfiles}

# your project folder that we can `c [tab]` to
export PROJECTS=~/code

# Stash your environment variables in ~/.localrc. This means they'll stay out
# of your main dotfiles repository (which may be public, like this one), but
# you'll have access to them in your scripts.
if [[ -a ~/.localrc ]]
then
  source ~/.localrc
fi

# all of our zsh files
typeset -U config_files
config_files=($ZSH/**/*.zsh)

# load the path files
for file in ${(M)config_files:#*/path.zsh}
do
  source $file
done

# load everything but the path and completion files
for file in ${${config_files:#*/path.zsh}:#*/completion.zsh}
do
  source $file
done

# use zsh-completions brew package for autocomplete (must be on FPATH before compinit)
# https://github.com/zsh-users/zsh-completions
if [[ -d "${HOMEBREW_PREFIX:-/usr/local}/share/zsh-completions" ]]
then
  FPATH="${HOMEBREW_PREFIX:-/usr/local}/share/zsh-completions:$FPATH"
fi

# Initialize the completion system before sourcing completion.zsh files, since
# they (and tools like fzf/direnv/mise) call `compdef`, which compinit defines.
autoload -Uz compinit
# Cache compinit and only refresh once a day
# See https://htr3n.github.io/2018/07/faster-zsh/ for more
# (glob qualifiers: N = no error if missing, mh+23 = modified 24+ hours ago)
stale_zcompdump=(${ZDOTDIR:-$HOME}/.zcompdump(N.mh+23))
if [[ ! -f ${ZDOTDIR:-$HOME}/.zcompdump || -n $stale_zcompdump ]]; then
  compinit
else
  compinit -C
fi
unset stale_zcompdump

# load completion.zsh files after compinit so `compdef` is defined
for file in ${(M)config_files:#*/completion.zsh}
do
  source $file
done
unset config_files

# Better history
# Credits to https://coderwall.com/p/jpj_6q/zsh-better-history-searching-with-arrow-keys
autoload -U up-line-or-beginning-search
autoload -U down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey "^[[A" up-line-or-beginning-search # Up
bindkey "^[[B" down-line-or-beginning-search # Down

cached_eval fzf fzf --zsh

# Add direnv hook to load `.envrc` files
if [ -x "$(command -v direnv)" ]; then
  cached_eval direnv direnv hook zsh
fi

# mise activation for interactive shells
cached_eval mise-activate mise activate zsh
# Activation already ran `mise hook-env`; mark it as done so mise's precmd hook
# doesn't run it again before the first prompt
export __MISE_ZSH_CHPWD_RAN=1

export PATH="$HOME/.local/bin:$PATH"
